#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>
/* shim so the dongle build can include a common file */
#include "eyelash_corne.keymap"

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <30>;
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "ALPHA";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R  &kp T                             &kp UP                &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G                   &kp LEFT  &mkp LCLK  &kp RIGHT  &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&td0       &kp Z  &kp X  &kp C     &kp V  &kp B      &kp SPACE              &kp DOWN              &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ENTER
                         &kp LGUI  &mo 1  &kp SPACE                                               &kp SPACE  &mo 1  &mo 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ============ L1: NUMBER / NAV / MOUSE ============ */

        lower_layer {
            display-name = "NUM";
            bindings = <
&trans  &kp N1    &kp N2     &kp N3   &kp N4     &kp N5                                   &mmv MOVE_UP                     &kp N6     &kp N7     &kp N8    &kp N9     &kp N0    &trans
&trans  &kp HOME  &kp F3    &kp TAB  &kp LALT   &kp PG_UP                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp MINUS  &kp EQUAL  &kp UP    &kp LBKT   &kp RBKT  &kp BSLH
&trans  &kp END   &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp PG_DN  &kp C_MUTE                    &mmv MOVE_DOWN                   &kp GRAVE  &kp LEFT   &kp DOWN  &kp RIGHT  &none     &trans
                             &trans   &trans     &trans                                                                    &trans     &trans     &none
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        /* ============ L2: SYSTEM / RGB / BT ============ */

        raise_layer {
            display-name = "SYS";
            bindings = <
&none      &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                               &mmv MOVE_UP                     &none  &none   &none   &none    &none  &none
&ext_power EP_TOG  &bt BT_CLR       &bt BT_CLR_ALL  &out OUT_USB     &out OUT_BLE     &rgb_ug RGB_BRI            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none   &kp C_MUTE    &kp C_VOL_UP    &none      &none    &ext_power EP_TOG
&sys_reset  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_BRD  &trans                    &mmv MOVE_DOWN                   &none   &kp F1  &kp C_VOL_DN  &kp F2  &none    &sys_reset
                                             &none           &none           &none                                                                      &none  &none    &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
