#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        /* Keep the dongle “fake keyboard” setup */
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &physical_layout0;

        /* Point Zephyr/ZMK at the OLED device below */
        zephyr,display = &oled;
    };

    /* If any module expects xiao_i2c, map it to the nice!nano’s Pro Micro I2C */
    aliases {
        xiao_i2c = &pro_micro_i2c;
    };

    /* Minimal kscan + layout so ZMK app boots on a dongle */
    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                      RC(0,12)           RC(0,13) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)             RC(2,12) RC(4,12) RC(3,12)  RC(1,13) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,2)              RC(1,12)           RC(2,13) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                    RC(3,3) RC(3,4) RC(3,5)                                         RC(3,13) RC(3,7) RC(3,8)
        >;
    };
};

/* --- OLED on nice!nano’s Pro Micro I2C header (SDA/SCL) --- */
&pro_micro_i2c {
    status = "okay";
    /* Optional but common; most panels are OK at 400kHz */
    bus-speed = <I2C_BITRATE_FAST>;

    /* ===== Default: 1.3" SH1106 128x64 ===== */
    oled: sh1106@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        /* SH1106 needs segment offset 2 for proper centering */
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        inversion-on;
        prechargep = <0x22>;
    };

    /* ===== Alternate: 0.91"/1.3" SSD1306 =====
    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;         // Use <32> for 128x32 panels
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>; // For 128x32 use <31>
        segment-remap;
        com-invdir;
        inversion-on;
        prechargep = <0x22>;
    };
    */
};
