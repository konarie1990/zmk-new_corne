#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &physical_layout0;
    };
        /* Enable I2C0 and set frequency via standard define */
        &i2c0 {
            status = "okay";
            clock-frequency = <I2C_BITRATE_STANDARD>;
            pinctrl-0 = <&i2c0_default>;
            pinctrl-names = "default";
        };
        
        /* Pick the actual pins your dongle uses for OLED (examples shown) */
        &pinctrl {
            i2c0_default: i2c0_default {
                group1 {
                    /* Example: TWIM SCL on P0.03, SDA on P0.02 — adjust as needed */
                    psels = <NRF_PSEL(TWIM_SCL, 0, 3)>, <NRF_PSEL(TWIM_SDA, 0, 2)>;
                    bias-pull-up;
                };
            };
        };
    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                      RC(0,12)           RC(0,13) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)             RC(2,12) RC(4,12) RC(3,12)  RC(1,13) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,2)              RC(1,12)           RC(2,13) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                    RC(3,3) RC(3,4) RC(3,5)                                         RC(3,13) RC(3,7) RC(3,8)
        >;
    };
};

/* Enable the Pro Micro I2C bus used by nice!nano; pins come from pinctrl */
&pro_micro_i2c {
    status = "okay";
    /* Optional: uncomment to change speed
     * clock-frequency = <I2C_BITRATE_STANDARD>; // or I2C_BITRATE_FAST
     */
}
